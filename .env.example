# Google Apps Script Web App URL (ends with /exec).
# Leave empty to run in local-only mode (no cloud sync).
VITE_APPS_SCRIPT_URL=

# Must match APP_SECRET inside apps-script/Code.gs.
# This is a simple shared token, not real authentication. Keep it private.
VITE_APP_SECRET=

# Base path for GitHub Pages. Usually "/<repository-name>/".
# Leave empty (or "/") for local development.
VITE_BASE_PATH=
