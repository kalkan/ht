# ---------- Frontend (Vite, optional) ----------
# Prefill the cloud secret during local development so you don't have to type
# it in Settings. In production the user enters it once in the app instead.
VITE_APP_SECRET=

# Point the app at another deployment's API (default: same origin /api/logs).
VITE_CLOUD_API_URL=

# ---------- Netlify Function (set in Netlify → Environment variables) ----------
# Shared PIN/secret the app must send. At least 6 characters; use something long.
APP_SECRET=

# Neon Postgres connection string. Netlify DB sets NETLIFY_DATABASE_URL
# automatically; otherwise paste your Neon connection string here.
DATABASE_URL=
