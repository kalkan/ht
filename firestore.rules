rules_version = '2';

// Daily Tracker — one document per day under users/{uid}/dailyLogs/{date}.
// Only the signed-in owner can read or write their own documents, and an
// older version can never overwrite a newer one (last-write-wins on updatedAt).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidLog(d, date) {
      return d.keys().hasOnly(['id', 'date', 'workout', 'cigarettes', 'waterEnough', 'alcohol',
                               'healthyDiet', 'weight', 'createdAt', 'updatedAt', 'deviceId'])
        && d.id is string && d.id.size() > 0 && d.id.size() <= 100
        && d.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.workout in ['push', 'pull', 'legs_core', 'cardio', 'none']
        && d.cigarettes is int && d.cigarettes >= 0 && d.cigarettes <= 1000
        && d.waterEnough is bool && d.alcohol is bool && d.healthyDiet is bool
        && (!('weight' in d) || d.weight == null || (d.weight is number && d.weight > 0 && d.weight < 500))
        && d.createdAt is string && d.updatedAt is string
        && d.deviceId is string && d.deviceId.size() <= 100;
    }

    match /users/{uid}/dailyLogs/{date} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidLog(request.resource.data, date);
      allow update: if isOwner(uid) && isValidLog(request.resource.data, date)
                    && request.resource.data.updatedAt >= resource.data.updatedAt
                    && request.resource.data.id == resource.data.id;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
